{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "learning-kb run manifest",
  "type": "object",
  "required": ["run_id", "ts", "actions"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run_[0-9]{8}T[0-9]{6}$"},
    "ts": {"type": "string"},
    "backup_dir": {"type": "string", "description": "runs/backups/<run_id>/"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "files"],
        "properties": {
          "stage": {"type": "string"},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["staged", "vault"],
              "properties": {
                "staged": {"type": "string", "description": "staging 内相对路径"},
                "vault": {"type": "string", "description": "vault 内相对路径"},
                "op": {"enum": ["create", "update", "delete"]}
              }
            }
          }
        }
      }
    }
  }
}
